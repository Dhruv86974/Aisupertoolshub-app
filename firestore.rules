rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'dhruvtarsariya3@gmail.com');
    }
    match /transactions/{txnId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || request.auth.token.email == 'dhruvtarsariya3@gmail.com');
      allow update, delete: if request.auth != null && request.auth.token.email == 'dhruvtarsariya3@gmail.com';
    }
  }
}
